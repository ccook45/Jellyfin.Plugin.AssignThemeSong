<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.xThemeSong</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.xThemeSong</RootNamespace>
    <Version>1.4.17.0</Version>
    <AssemblyVersion>1.4.17.0</AssemblyVersion>
    <FileVersion>1.4.17.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="YoutubeExplode" Version="6.6.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\**\*" />
    <EmbeddedResource Include="images\**\*" />
    <EmbeddedResource Include="web\**\*" />
    <None Include="web\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="meta.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RemoveUnnecessaryAssemblies" AfterTargets="Build">
    <ItemGroup>
      <FilesToDelete Include="$(OutputPath)Jellyfin.Controller.dll" />
      <FilesToDelete Include="$(OutputPath)Jellyfin.Model.dll" />
      <FilesToDelete Include="$(OutputPath)Jellyfin.Data.dll" />
      <FilesToDelete Include="$(OutputPath)Jellyfin.Extensions.dll" />
      <FilesToDelete Include="$(OutputPath)Jellyfin.Networking.dll" />
      <FilesToDelete Include="$(OutputPath)Jellyfin.MediaEncoding.dll" />
      <FilesToDelete Include="$(OutputPath)MediaBrowser.*.dll" />
      <FilesToDelete Include="$(OutputPath)Emby.*.dll" />
      <FilesToDelete Include="$(OutputPath)System.*.dll" />
      <FilesToDelete Include="$(OutputPath)Microsoft.*.dll" />
      <FilesToDelete Include="$(OutputPath)Newtonsoft.Json.dll" />
      <FilesToDelete Include="$(OutputPath)ICU4N*.dll" />
      <FilesToDelete Include="$(OutputPath)J2N.dll" />
      <FilesToDelete Include="$(OutputPath)Diacritics.dll" />
      <FilesToDelete Include="$(OutputPath)*.pdb" />
      <FilesToDelete Include="$(OutputPath)*.xml" />
      <FilesToDelete Include="$(OutputPath)*.runtimeconfig.json" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)" />
    <Message Text="Removed Jellyfin host assemblies and unnecessary files (kept Jellyfin.Plugin.xThemeSong.dll)" Importance="high" />
  </Target>

</Project>
